{
  "name": "TestPipeline",
  "version": "1.0",
  "topology": "Triangle",
  
  "shaders": {
    "vertex": {
      "hlsl_guid": "vs-grid-placeholder-guid",
      "entry_point": "main",
      "target": "vs_6_0",
      "defines": []
    },
    "pixel": {
      "hlsl_guid": "ps-grid-placeholder-guid",
      "entry_point": "main",
      "target": "ps_6_0",
      "defines": [ "DEBUG_GRID" ]
    }
  },

  "rasterizer": {
    "fill_mode": "Solid", 
    "cull_mode": "None",
    "depth_bias": 0
  },

  "depth_stencil": {
    "depth_enable": true,
    "depth_write": true,
    "depth_func": "LessEqual"
  },

  "blend": {
    "mode": "Normal" 
  },

  "output": {
    "use_engine_default_rtv": true,
    "rtv_formats": [], 
    "dsv_format": "D32_Float"
  }
}
